@model IEnumerable<GestionTareasUniversitarias.Models.Tarea>

@{
    ViewData["Title"] = "Mis tareas";
    var estadoFiltro = ViewBag.EstadoFiltro as int?;
    var buscar = ViewBag.Buscar as string;
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="page-title">Mis Tareas</h1>
        <p class="page-subtitle mb-0">@Model.Count() tareas encontradas</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Tarea</a>
</div>

<form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 mb-4">
    <input type="search" name="buscar" value="@buscar" class="form-control" style="max-width: 340px;" placeholder="🔍 Buscar tareas..." />
    <select name="materiaId" class="form-select" style="max-width: 240px;" asp-items="ViewBag.MateriaId">
        <option value="">Todas las materias</option>
    </select>
    <button type="submit" class="btn btn-outline-secondary">Buscar</button>
</form>

<div class="filter-pills mb-4">
    <a class="pill @(estadoFiltro == null ? "active" : "")"
       asp-action="Index" asp-route-materiaId="@ViewBag.MateriaIdSeleccionada" asp-route-buscar="@buscar">Todos</a>
    <a class="pill @(estadoFiltro == 0 ? "active" : "")"
       asp-action="Index" asp-route-estado="0" asp-route-materiaId="@ViewBag.MateriaIdSeleccionada" asp-route-buscar="@buscar">Pendiente</a>
    <a class="pill @(estadoFiltro == 1 ? "active" : "")"
       asp-action="Index" asp-route-estado="1" asp-route-materiaId="@ViewBag.MateriaIdSeleccionada" asp-route-buscar="@buscar">En progreso</a>
    <a class="pill @(estadoFiltro == 2 ? "active" : "")"
       asp-action="Index" asp-route-estado="2" asp-route-materiaId="@ViewBag.MateriaIdSeleccionada" asp-route-buscar="@buscar">Completada</a>
    <a class="pill @(estadoFiltro == 99 ? "active" : "")"
       asp-action="Index" asp-route-estado="99" asp-route-materiaId="@ViewBag.MateriaIdSeleccionada" asp-route-buscar="@buscar">Vencida</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay tareas para mostrar. <a asp-action="Create" class="alert-link">Crea tu primera tarea</a>.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            var ahora = DateTime.Now;
            var vencida = item.Estado != EstadoTarea.Completada && item.FechaLimite < ahora;
            var claseEstado = vencida ? "b-vencida" :
                item.Estado == EstadoTarea.Completada ? "b-completada" :
                item.Estado == EstadoTarea.EnProgreso ? "b-progreso" : "b-pendiente";
            var textoEstado = vencida ? "Vencida" : item.Estado switch
            {
                EstadoTarea.EnProgreso => "En progreso",
                EstadoTarea.Completada => "Completada",
                _ => "Pendiente"
            };

            <div class="col-md-6 col-lg-4">
                <div class="task-card">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <span class="materia-tag tag-@(item.MateriaId % 6)" title="@item.Materia?.Nombre">@item.Materia?.Nombre</span>
                        <span class="estado-badge @claseEstado">@textoEstado</span>
                    </div>
                    <h5>@item.Titulo</h5>
                    <p class="desc">@item.Descripcion</p>
                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                        <span class="fecha @(vencida ? "vencida-fecha" : "")">📅 @item.FechaLimite.ToString("dd MMM yyyy")</span>
                        <span class="acciones">
                            @if (item.Estado != EstadoTarea.Completada)
                            {
                                <button type="button" class="btn-completar" data-id="@item.Id" title="Marcar como completada">✔</button>
                            }
                            <a asp-action="Edit" asp-route-id="@item.Id" title="Editar">✏️</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">🗑️</a>
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/tareas.js" asp-append-version="true"></script>
}
