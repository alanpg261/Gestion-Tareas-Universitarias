@model GestionTareasUniversitarias.Models.EstadisticasViewModel

@{
    ViewData["Title"] = "Estadísticas";
}

<h1 class="page-title">Estadísticas</h1>
<p class="page-subtitle">Indicadores de tu progreso académico por materia y estado.</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icono">📝</div>
            <div class="stat-valor">@Model.TotalTareas</div>
            <div class="stat-nombre">Total de tareas</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icono">✅</div>
            <div class="stat-valor">@Model.Completadas</div>
            <div class="stat-nombre">Completadas</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icono">⏰</div>
            <div class="stat-valor">@Model.Pendientes</div>
            <div class="stat-nombre">Pendientes</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icono">📈</div>
            <div class="stat-valor">@Model.TasaCompletadas%</div>
            <div class="stat-nombre">Tasa de finalización</div>
        </div>
    </div>
</div>

<div class="stat-card">
    <h5 class="mb-3">Carga por materia</h5>

    @if (!Model.PorMateria.Any())
    {
        <div class="alert alert-info mb-0">
            No tienes materias registradas. <a asp-controller="Materias" asp-action="Create" class="alert-link">Crea tu primera materia</a>.
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var materia in Model.PorMateria)
            {
                var porcentaje = materia.Total == 0 ? 0 : (int)Math.Round(100.0 * materia.Completadas / materia.Total);
                <div>
                    <div class="d-flex justify-content-between mb-1">
                        <strong>@materia.Nombre</strong>
                        <small class="text-muted">
                            @materia.Total tareas · @materia.Completadas completadas · @materia.Pendientes pendientes
                            @if (materia.EnProgreso > 0)
                            {
                                <span>· @materia.EnProgreso en progreso</span>
                            }
                            @if (materia.Vencidas > 0)
                            {
                                <span class="text-danger">· @materia.Vencidas vencidas</span>
                            }
                        </small>
                    </div>
                    <div class="progress" role="progressbar" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: @porcentaje%"></div>
                    </div>
                </div>
            }
        </div>
    }
</div>
